model Rental {
  id          String       @id @default(uuid())
  startDate   DateTime
  endDate     DateTime
  totalDays   Int
  totalAmount Float
  status      RentalStatus @default(PENDING)
  gearId      String
  customerId  String
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  // Relationships
  gear     Gear     @relation(fields: [gearId], references: [id], onDelete: Cascade)
  customer User     @relation("CustomerRentals", fields: [customerId], references: [id], onDelete: Cascade)
  payment  Payment?
  review   Review?

  @@map("rentals")
}