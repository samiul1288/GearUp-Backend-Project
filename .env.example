PORT=5000
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require
APP_URL=http://localhost:3000
API_BASE_URL=http://localhost:5000
BCRYPT_SALT_ROUNDS=12
JWT_ACCESS_SECRET=replace-with-a-long-random-secret
JWT_REFRESH_SECRET=replace-with-a-different-long-random-secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

# Set these only in a private local .env file or deployment environment settings.
ADMIN_NAME=GearUp Administrator
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-unique-password-of-at-least-12-characters
ADMIN_RESET_PASSWORD=false

# Sandbox is enabled unless this is explicitly set to false.
SSLCOMMERZ_SANDBOX=true
SSLCOMMERZ_STORE_ID=
SSLCOMMERZ_STORE_PASSWORD=
